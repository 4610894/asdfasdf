<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Gerencial - Liquidação Inteligente</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.js"></script>
    <style>
        :root {
            --bg-main: #1b2030;
            --bg-card: #232a3b;
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent-cyan: #0ce8d1;
            --accent-cyan-bg: rgba(12, 232, 209, 0.1);
            --accent-orange: #f97316;
            --border-color: #334155;
            --radius: 6px;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-primary);
            margin: 0;
            padding: 20px;
            font-size: 14px;
        }

        .header-container { margin-bottom: 20px; }
        .header-container h1 { font-size: 22px; margin: 0 0 15px 0; font-weight: 600; color: var(--text-primary); }

        /* Controls */
        .controls-bar {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 25px 20px 20px 20px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            gap: 30px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .control-group { display: flex; flex-direction: column; gap: 8px; flex: 1; min-width: 200px; }
        .slider-group { flex: 2; min-width: 300px; }
        .control-group label { color: var(--text-secondary); font-size: 12px; text-transform: uppercase; font-weight: 600; }

        select {
            background: var(--bg-main);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 8px 10px;
            border-radius: 4px;
            outline: none;
            width: 100%;
        }

        .noUi-connect { background: var(--accent-cyan); }
        .noUi-handle { border: 1px solid var(--accent-cyan); box-shadow: none; background: var(--bg-card); }

        /* Tabs System */
        .tabs-container {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 10px;
            overflow-x: auto;
        }

        .tab-btn {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid transparent;
            padding: 10px 20px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            white-space: nowrap;
        }

        .tab-btn:hover { color: var(--text-primary); background: var(--bg-card); }
        .tab-btn.active { 
            color: var(--accent-cyan); 
            border: 1px solid var(--accent-cyan);
            background: var(--accent-cyan-bg);
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.3s ease; }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        /* KPIs & Charts */
        .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px; }
        .kpi-card {
            background-color: var(--bg-card); border: 1px solid var(--border-color);
            border-radius: var(--radius); padding: 20px; display: flex; flex-direction: column; gap: 8px;
            transition: border-color 0.3s;
        }
        .kpi-card:hover { border-color: var(--accent-cyan); }
        .kpi-title { color: var(--text-secondary); font-size: 13px; font-weight: 400; }
        .kpi-value { font-size: 26px; font-weight: 700; color: #ffffff; margin: 5px 0; }
        .kpi-sub {
            font-size: 12px; color: var(--accent-cyan); background: var(--accent-cyan-bg);
            padding: 4px 8px; border-radius: 4px; width: fit-content;
        }
        .kpi-sub.alert { color: var(--accent-orange); background: rgba(249, 115, 22, 0.1); }

        .chart-container {
            background-color: var(--bg-main); border: 1px solid var(--border-color);
            border-radius: var(--radius); padding: 20px; height: 350px; margin-bottom: 20px;
            position: relative; /* Necessário para responsividade correta do Chart.js */
        }

    </style>
</head>
<body>

    <div class="header-container">
        <h1>Centro de Inteligência de Liquidação</h1>
        
        <div class="controls-bar">
            <div class="control-group slider-group">
                <label>Período Base: <span id="dateLabel" style="color: var(--accent-cyan);"></span></label>
                <div id="date-slider" style="margin-top: 10px;"></div>
            </div>
            <div class="control-group">
                <label>Gestor</label>
                <select id="filtroGestor" onchange="atualizarDashboardGlobal()">
                    <option value="Todos">Todos os Gestores</option>
                    <option value="Gestor A">Gestor A (Multimercado)</option>
                    <option value="Gestor B">Gestor B (Renda Fixa)</option>
                    <option value="Gestor C">Gestor C (Ações)</option>
                </select>
            </div>
            <div class="control-group">
                <label>Origem</label>
                <select id="filtroOrigem" onchange="atualizarDashboardGlobal()">
                    <option value="Todos">Todas (Itaú + Mercado)</option>
                    <option value="Itaú">Apenas Itaú (Casa)</option>
                    <option value="Mercado">Apenas Mercado (Fora)</option>
                </select>
            </div>
        </div>

        <!-- TABS NAV -->
        <div class="tabs-container">
            <button class="tab-btn active" onclick="openTab('tab-vol')">Volume Intradiário</button>
            <button class="tab-btn" onclick="openTab('tab-fin')">Financeiro por Horário</button>
            <button class="tab-btn" onclick="openTab('tab-gestores')">Top Gestores</button>
            <button class="tab-btn" onclick="openTab('tab-corretoras')">Top Corretoras</button>
            <button class="tab-btn" onclick="openTab('tab-leadtime')">Leadtime (SLA)</button>
        </div>
    </div>

    <!-- TAB 1: Volume Intradiário (Original) -->
    <div id="tab-vol" class="tab-content active">
        <div class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-title">Pico de Liquidação (Vol)</span>
                <span class="kpi-value" id="kpiVolPico">--:--</span>
                <span class="kpi-sub" id="kpiVolPicoSub">--</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Horário mais Volátil</span>
                <span class="kpi-value" id="kpiVolVolatil">--:--</span>
                <span class="kpi-sub">Alta dispersão (p25-p75)</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Média Diária (Operações)</span>
                <span class="kpi-value" id="kpiVolMedia">0</span>
                <span class="kpi-sub alert" id="kpiVolTicket">Ticket: R$ 0,00</span>
            </div>
        </div>
        <div class="chart-container"><canvas id="chartVol"></canvas></div>
    </div>

    <!-- TAB 2: Financeiro -->
    <div id="tab-fin" class="tab-content">
        <div class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-title">Pico Financeiro</span>
                <span class="kpi-value" id="kpiFinPico">--:--</span>
                <span class="kpi-sub" id="kpiFinPicoSub">--</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Média Diária (Financeiro)</span>
                <span class="kpi-value" id="kpiFinMedia">R$ 0,00</span>
                <span class="kpi-sub">Por dia útil</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Total Movimentado no Período</span>
                <span class="kpi-value" style="color: var(--accent-orange)" id="kpiFinTotal">R$ 0,00</span>
                <span class="kpi-sub alert" style="background: transparent">Acumulado</span>
            </div>
        </div>
        <div class="chart-container"><canvas id="chartFin"></canvas></div>
    </div>

    <!-- TAB 3: Gestores -->
    <div id="tab-gestores" class="tab-content">
        <div class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-title">Gestor Líder (Vol. Fin.)</span>
                <span class="kpi-value" id="kpiGestorLider">--</span>
                <span class="kpi-sub" id="kpiGestorShare">--% de Share</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Concentração Top 1</span>
                <span class="kpi-value" id="kpiGestorConc">0%</span>
                <span class="kpi-sub">Risco de dependência</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Ticket Médio do Líder</span>
                <span class="kpi-value" id="kpiGestorTicket">R$ 0,00</span>
                <span class="kpi-sub alert">Destaque</span>
            </div>
        </div>
        <div class="chart-container"><canvas id="chartGestores"></canvas></div>
    </div>

    <!-- TAB 4: Corretoras -->
    <div id="tab-corretoras" class="tab-content">
        <div class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-title">Corretora Mais Ativa</span>
                <span class="kpi-value" id="kpiCorrLider">--</span>
                <span class="kpi-sub" id="kpiCorrOps">-- operações</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Market Share (Itaú Corretora)</span>
                <span class="kpi-value" id="kpiCorrItauShare">0%</span>
                <span class="kpi-sub">Internalização</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Corretoras Ativas no Período</span>
                <span class="kpi-value" id="kpiCorrCount">0</span>
                <span class="kpi-sub alert">Diversificação</span>
            </div>
        </div>
        <div class="chart-container" style="display: flex; justify-content: center; height: 350px;">
            <div style="width: 50%; height: 100%;"><canvas id="chartCorretoras"></canvas></div>
        </div>
    </div>

    <!-- TAB 5: Leadtime -->
    <div id="tab-leadtime" class="tab-content">
        <div class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-title">Leadtime Médio Global</span>
                <span class="kpi-value" id="kpiLeadMedia">0 min</span>
                <span class="kpi-sub">Tempo de Processamento</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">Horário Mais Crítico (Gargalo)</span>
                <span class="kpi-value" id="kpiLeadGargalo">--:--</span>
                <span class="kpi-sub alert" id="kpiLeadGargaloVal">-- min</span>
            </div>
            <div class="kpi-card">
                <span class="kpi-title">SLA (< 15 min)</span>
                <span class="kpi-value" style="color: var(--accent-cyan)" id="kpiLeadSLA">0%</span>
                <span class="kpi-sub">Aderência ao Acordo</span>
            </div>
        </div>
        <div class="chart-container"><canvas id="chartLeadtime"></canvas></div>
    </div>

    <script>
        // --- 0. INICIALIZAÇÃO CORRETA DAS VARIÁVEIS ---
        // Agora as instâncias dos gráficos são declaradas no início para evitar erros de referência nula
        const charts = { vol: null, fin: null, gest: null, corr: null, lead: null };

        // Formatações e conversões seguras (float)
        const formatBRL = (v) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(v);
        const formatBRLShort = (v) => {
            if(v >= 1000000) return 'R$ ' + (v/1000000).toFixed(2).replace('.', ',') + 'M';
            if(v >= 1000) return 'R$ ' + (v/1000).toFixed(2).replace('.', ',') + 'k';
            return formatBRL(v);
        };

        // Tab Navigation
        function openTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        // 1. Base de Dados Fictícia Rica
        const rawData = [];
        const uniqueDays = [];
        const hours = ['08:00', '09:00', '10:00', '11:00', '12:00', '13:00', '14:00', '15:00', '16:00', '17:00', '18:00'];
        const gestores = ['Gestor A', 'Gestor B', 'Gestor C'];
        const origens = ['Itaú', 'Mercado'];
        const corretorasList = ['Itaú Corretora', 'XP Investimentos', 'BTG Pactual', 'Genial Investimentos', 'Merrill Lynch'];

        const today = new Date();
        today.setHours(0,0,0,0);

        for (let i = 30; i >= 0; i--) {
            const date = new Date(today);
            date.setDate(date.getDate() - i);
            const dateStr = date.toISOString().split('T')[0];
            const displayDate = date.toLocaleDateString('pt-BR');
            uniqueDays.push({ dateStr, displayDate });

            hours.forEach(hour => {
                gestores.forEach(gestor => {
                    origens.forEach(origem => {
                        let baseVol = (gestor === 'Gestor A') ? 12 : 6;
                        if (origem === 'Itaú') baseVol += 5;
                        if (hour === '11:00' || hour === '10:00') baseVol *= 2.5;
                        if (hour === '15:00') baseVol *= 1.8; 
                        
                        let ops = Math.floor(Math.random() * 20) + baseVol;
                        const valFloat = parseFloat((Math.random() * (15000.50 - 1500.25) + 1500.25).toFixed(2));
                        
                        let corr = 'Itaú Corretora';
                        if (Math.random() > 0.4) { corr = corretorasList[Math.floor(Math.random() * corretorasList.length)]; }

                        let baseLead = Math.random() * 8 + 2;
                        if(hour === '15:00' || hour === '16:00') baseLead += (Math.random() * 20);

                        rawData.push({ 
                            dateStr, hour, gestor, origem, 
                            corretora: corr, 
                            volume: ops, 
                            valor: valFloat,
                            leadtime: parseFloat(baseLead.toFixed(1))
                        });
                    });
                });
            });
        }

        // 2. Setup Slider
        const dateSlider = document.getElementById('date-slider');
        const maxIndex = uniqueDays.length - 1;

        noUiSlider.create(dateSlider, {
            start: [maxIndex - 14, maxIndex], connect: true, step: 1, range: { 'min': 0, 'max': maxIndex },
            format: { to: v => Math.round(v), from: v => Math.round(v) }
        });

        // Garantir que a renderização inicial funcione
        dateSlider.noUiSlider.on('update', atualizarDashboardGlobal);

        // Chamada manual de segurança ao carregar a janela
        window.onload = () => {
            atualizarDashboardGlobal();
        };

        function atualizarDashboardGlobal() {
            const sliderValues = dateSlider.noUiSlider.get();
            const startStr = uniqueDays[sliderValues[0]].dateStr;
            const endStr = uniqueDays[sliderValues[1]].dateStr;
            
            document.getElementById('dateLabel').innerText = `${uniqueDays[sliderValues[0]].displayDate} a ${uniqueDays[sliderValues[1]].displayDate}`;
            
            const gFiltro = document.getElementById('filtroGestor').value;
            const oFiltro = document.getElementById('filtroOrigem').value;

            const dadosFiltrados = rawData.filter(d => 
                d.dateStr >= startStr && d.dateStr <= endStr &&
                (gFiltro === 'Todos' || d.gestor === gFiltro) &&
                (oFiltro === 'Todos' || d.origem === oFiltro)
            );

            const diasUnicos = new Set(dadosFiltrados.map(d => d.dateStr)).size || 1;

            updateTabVolume(dadosFiltrados, diasUnicos);
            updateTabFinanceiro(dadosFiltrados, diasUnicos);
            updateTabGestores(dadosFiltrados);
            updateTabCorretoras(dadosFiltrados);
            updateTabLeadtime(dadosFiltrados);
        }

        // --- UPDATES PER TAB ---

        function updateTabVolume(dados, diasUnicos) {
            const hourlyStats = {};
            hours.forEach(h => hourlyStats[h] = { vols: [] });

            const porDiaEHora = {};
            let totalVol = 0, totalVal = 0, qtdOps = 0;

            dados.forEach(d => {
                const k = `${d.dateStr}_${d.hour}`;
                if(!porDiaEHora[k]) porDiaEHora[k] = 0;
                porDiaEHora[k] += d.volume;
                totalVol += d.volume;
                totalVal += d.valor * d.volume;
                qtdOps += d.volume;
            });

            Object.keys(porDiaEHora).forEach(k => {
                const hr = k.split('_')[1];
                hourlyStats[hr].vols.push(porDiaEHora[k]);
            });

            const dMed = [], dP25 = [], dP75 = [];
            let picoH = '--:--', maxM = 0, volH = '--:--', maxDisp = 0;

            hours.forEach(h => {
                const v = hourlyStats[h].vols.sort((a,b)=>a-b);
                if(v.length===0) { dMed.push(0); dP25.push(0); dP75.push(0); return; }
                const med = Math.round(v.reduce((a,b)=>a+b,0)/v.length);
                dMed.push(med);
                if(med > maxM) { maxM = med; picoH = h; }

                const p25 = v[Math.floor(v.length*0.25)], p75 = v[Math.floor(v.length*0.75)];
                dP25.push(p25); dP75.push(p75);
                if((p75-p25) > maxDisp) { maxDisp = p75-p25; volH = h; }
            });

            document.getElementById('kpiVolPico').innerText = picoH;
            document.getElementById('kpiVolPicoSub').innerText = `+${maxM} ops/dia`;
            document.getElementById('kpiVolVolatil').innerText = volH;
            document.getElementById('kpiVolMedia').innerText = Math.round(totalVol/diasUnicos).toLocaleString('pt-BR');
            document.getElementById('kpiVolTicket').innerText = `Ticket: ${formatBRL(totalVal/(qtdOps||1))}`;

            if(charts.vol) {
                charts.vol.data.datasets[0].data = dP75;
                charts.vol.data.datasets[1].data = dP25;
                charts.vol.data.datasets[2].data = dMed;
                charts.vol.update();
            } else {
                const ctx = document.getElementById('chartVol').getContext('2d');
                charts.vol = new Chart(ctx, {
                    type: 'line',
                    data: { labels: hours, datasets: [
                        { label:'P75', data:dP75, borderColor:'transparent', backgroundColor:'rgba(12, 232, 209, 0.1)', fill:'+1', pointRadius:0, tension:0.4 },
                        { label:'P25', data:dP25, borderColor:'transparent', fill:false, pointRadius:0, tension:0.4 },
                        { label:'Média', data:dMed, borderColor:'#0ce8d1', borderWidth:2, pointBackgroundColor:'#1e2536', pointBorderColor:'#0ce8d1', fill:false, tension:0.4 }
                    ]},
                    options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{x:{grid:{display:false}},y:{grid:{color:'#334155'}}} }
                });
            }
        }

        function updateTabFinanceiro(dados, diasUnicos) {
            const hStats = {};
            hours.forEach(h => hStats[h] = 0);
            let totalFin = 0;

            dados.forEach(d => {
                const f = parseFloat((d.valor * d.volume).toFixed(2));
                hStats[d.hour] += f;
                totalFin += f;
            });

            let dMedFin = [], picoH = '--:--', maxF = 0;
            hours.forEach(h => {
                const mediaHora = hStats[h] / diasUnicos;
                dMedFin.push(mediaHora);
                if(mediaHora > maxF) { maxF = mediaHora; picoH = h; }
            });

            document.getElementById('kpiFinPico').innerText = picoH;
            document.getElementById('kpiFinPicoSub').innerText = formatBRLShort(maxF) + ' na média';
            document.getElementById('kpiFinMedia').innerText = formatBRLShort(totalFin / diasUnicos);
            document.getElementById('kpiFinTotal').innerText = formatBRLShort(totalFin);

            if(charts.fin) {
                charts.fin.data.datasets[0].data = dMedFin;
                charts.fin.update();
            } else {
                charts.fin = new Chart(document.getElementById('chartFin').getContext('2d'), {
                    type: 'line',
                    data: { labels: hours, datasets: [{
                        label: 'Volume Fin. Médio (R$)', data: dMedFin,
                        borderColor: '#f97316', backgroundColor: 'rgba(249, 115, 22, 0.2)', borderWidth: 2, fill: true, tension: 0.4
                    }]},
                    options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{x:{grid:{display:false}},y:{grid:{color:'#334155'}}} }
                });
            }
        }

        function updateTabGestores(dados) {
            const stats = {};
            let total = 0;
            dados.forEach(d => {
                const v = parseFloat((d.valor * d.volume).toFixed(2));
                if(!stats[d.gestor]) stats[d.gestor] = { fin: 0, vol: 0 };
                stats[d.gestor].fin += v;
                stats[d.gestor].vol += d.volume;
                total += v;
            });

            const sorted = Object.entries(stats).sort((a,b)=>b[1].fin - a[1].fin);
            if(sorted.length > 0) {
                const lider = sorted[0];
                document.getElementById('kpiGestorLider').innerText = lider[0];
                document.getElementById('kpiGestorShare').innerText = Math.round((lider[1].fin/total)*100) + '% de Share';
                document.getElementById('kpiGestorConc').innerText = Math.round((lider[1].fin/total)*100) + '%';
                document.getElementById('kpiGestorTicket').innerText = formatBRLShort(lider[1].fin / lider[1].vol);
            }

            const lbls = sorted.map(s => s[0]);
            const vals = sorted.map(s => s[1].fin);

            if(charts.gest) {
                charts.gest.data.labels = lbls;
                charts.gest.data.datasets[0].data = vals;
                charts.gest.update();
            } else {
                charts.gest = new Chart(document.getElementById('chartGestores').getContext('2d'), {
                    type: 'bar',
                    data: { labels: lbls, datasets: [{
                        label: 'Volume Fin.', data: vals,
                        backgroundColor: '#0ce8d1', borderRadius: 4
                    }]},
                    options: { indexAxis: 'y', responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{x:{grid:{color:'#334155'}},y:{grid:{display:false}}} }
                });
            }
        }

        function updateTabCorretoras(dados) {
            const stats = {};
            let totalOps = 0;
            dados.forEach(d => {
                if(!stats[d.corretora]) stats[d.corretora] = 0;
                stats[d.corretora] += d.volume;
                totalOps += d.volume;
            });

            const sorted = Object.entries(stats).sort((a,b)=>b[1]-a[1]);
            let itauShare = 0;
            if(stats['Itaú Corretora']) itauShare = Math.round((stats['Itaú Corretora']/totalOps)*100);

            if(sorted.length > 0) {
                document.getElementById('kpiCorrLider').innerText = sorted[0][0];
                document.getElementById('kpiCorrOps').innerText = sorted[0][1].toLocaleString('pt-BR') + ' ops';
            }
            document.getElementById('kpiCorrItauShare').innerText = itauShare + '%';
            document.getElementById('kpiCorrCount').innerText = sorted.length;

            const lbls = sorted.map(s => s[0]);
            const vals = sorted.map(s => s[1]);
            const colors = ['#f97316', '#0ce8d1', '#3b82f6', '#8b5cf6', '#ec4899'];

            if(charts.corr) {
                charts.corr.data.labels = lbls;
                charts.corr.data.datasets[0].data = vals;
                charts.corr.update();
            } else {
                charts.corr = new Chart(document.getElementById('chartCorretoras').getContext('2d'), {
                    type: 'doughnut',
                    data: { labels: lbls, datasets: [{ data: vals, backgroundColor: colors, borderWidth: 0 }] },
                    options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{position:'right', labels:{color:'#94a3b8'}} }, cutout: '70%' }
                });
            }
        }

        function updateTabLeadtime(dados) {
            const hStats = {};
            hours.forEach(h => hStats[h] = { somaLead: 0, count: 0 });
            let totalLead = 0, countGlobal = 0, opsSLA = 0, totalOps = 0;

            dados.forEach(d => {
                hStats[d.hour].somaLead += d.leadtime * d.volume;
                hStats[d.hour].count += d.volume;
                totalLead += d.leadtime * d.volume;
                countGlobal += d.volume;
                totalOps += d.volume;
                if(d.leadtime <= 15.0) opsSLA += d.volume;
            });

            let dLead = [], maxLead = 0, gargaloH = '--:--';
            hours.forEach(h => {
                const med = hStats[h].count ? parseFloat((hStats[h].somaLead / hStats[h].count).toFixed(1)) : 0;
                dLead.push(med);
                if(med > maxLead) { maxLead = med; gargaloH = h; }
            });

            document.getElementById('kpiLeadMedia').innerText = (totalLead/countGlobal).toFixed(1) + ' min';
            document.getElementById('kpiLeadGargalo').innerText = gargaloH;
            document.getElementById('kpiLeadGargaloVal').innerText = maxLead + ' min na média';
            document.getElementById('kpiLeadSLA').innerText = Math.round((opsSLA/totalOps)*100) + '%';

            if(charts.lead) {
                charts.lead.data.datasets[0].data = dLead;
                charts.lead.update();
            } else {
                charts.lead = new Chart(document.getElementById('chartLeadtime').getContext('2d'), {
                    type: 'line',
                    data: { labels: hours, datasets: [{
                        label: 'Leadtime Médio (min)', data: dLead,
                        borderColor: '#ef4444', borderWidth: 3, pointBackgroundColor: '#ef4444', fill: false, tension: 0.2
                    }]},
                    options: { responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{x:{grid:{display:false}},y:{grid:{color:'#334155'}}} }
                });
            }
        }
    </script>
</body>
</html>
