    def _salvar_planilha_corretora(self, corretora, dados_novos, data_referencia_str):
        # 1. Verifica/Cria a pasta raiz de Relatórios
        pasta_base = "Relatorios_Gerados"
        if not os.path.exists(pasta_base):
            os.makedirs(pasta_base)
            
        # 2. Verifica/Cria a pasta específica da Corretora
        pasta_corretora = os.path.join(pasta_base, corretora)
        if not os.path.exists(pasta_corretora):
            os.makedirs(pasta_corretora)
            
        caminho_excel = os.path.join(pasta_corretora, f"Base_Operacoes_{corretora}.xlsx")
        
        df_novos = pd.DataFrame(dados_novos)
        
        # 3. Empilhar ou criar novo Excel
        if os.path.exists(caminho_excel):
            try:
                df_existente = pd.read_excel(caminho_excel)
                
                # Se houver operações registradas no dia sendo executado, apagamos elas para dar lugar à nova leitura
                if "Data Referência" in df_existente.columns:
                    df_existente = df_existente[df_existente["Data Referência"] != data_referencia_str]
                
                # Junta o histórico antigo preservado com a carga lida do dia
                df_final = pd.concat([df_existente, df_novos], ignore_index=True)
            except Exception as e:
                print(f"Erro ao ler histórico da {corretora}: {e}. Gerando novo arquivo.")
                df_final = df_novos
        else:
            # Se a planilha não existe, apenas grava os novos
            df_final = df_novos
            
        # 4. Ordenação cronológica dos dados
        # Cria colunas temporárias convertidas para o tipo datetime do Pandas (evita ordenação alfabética '01' > '02')
        if "Data Referência" in df_final.columns and "Data" in df_final.columns:
            df_final['Data_Ref_Temp'] = pd.to_datetime(df_final['Data Referência'], format='%d/%m/%Y', errors='coerce')
            df_final['Data_Op_Temp'] = pd.to_datetime(df_final['Data'], format='%d/%m/%Y', errors='coerce')
            
            # Ordena com base nas colunas temporárias e recria o index
            df_final = df_final.sort_values(by=['Data_Ref_Temp', 'Data_Op_Temp'], ascending=[True, True])
            
            # Remove as colunas temporárias antes de exportar
            df_final = df_final.drop(columns=['Data_Ref_Temp', 'Data_Op_Temp'])
            
        df_final.to_excel(caminho_excel, index=False)
        print(f"📄 Arquivo salvo para {corretora}: {len(dados_novos)} contratos da data {data_referencia_str} atualizados e ordenados.")
