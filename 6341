SELECT 
    CAST(data_liberacao_operacao AS DATE) AS data_str,
    -- Formata a hora para 'HH:00'
    LPAD(CAST(EXTRACT(HOUR FROM data_liberacao_operacao) AS VARCHAR), 2, '0') || ':00' AS hora,
    COALESCE(codigo_gestor_sac, 'N/A') AS gestor,
    
    -- Lógica para dividir Casa vs Mercado
    CASE 
        WHEN codigo_corretora_sac = 'ITAU' THEN 'Itaú' -- Substitua 'ITAU' pelo código exato usado na tabela
        ELSE 'Mercado' 
    END AS origem,
    
    COALESCE(codigo_corretora_sac, 'N/A') AS corretora,
    
    -- Métricas
    COUNT(DISTINCT codigo_operacao) AS volume,
    SUM(valor_financeiro) AS valor_total,
    
    -- Leadtime: diferença em minutos entre registro e liberação
    AVG(date_diff('minute', data_registro_operacao, data_liberacao_operacao)) AS leadtime

FROM 
    tb_operacao
WHERE 
    data_operacao >= CURRENT_DATE - INTERVAL '30' DAY
    AND grupo_situacao = 'LIQUIDADA' -- Ajuste para a string que define conclusão
    AND data_liberacao_operacao IS NOT NULL
GROUP BY 
    1, 2, 3, 4, 5
ORDER BY 
    data_str DESC, hora DESC;







SELECT 
    codigo_operacao AS id_operacao,
    codigo_gestor_sac AS gestor,
    CASE 
        WHEN codigo_corretora_sac = 'ITAU' THEN 'Itaú' 
        ELSE 'Mercado' 
    END AS origem,
    valor_financeiro,
    txt_estado_operacao AS status,
    data_registro_operacao AS atualizacao
FROM 
    tb_operacao
WHERE 
    data_operacao >= CURRENT_DATE - INTERVAL '5' DAY
    AND grupo_situacao NOT IN ('LIQUIDADA', 'CANCELADA')
ORDER BY 
    data_registro_operacao DESC
LIMIT 100;
